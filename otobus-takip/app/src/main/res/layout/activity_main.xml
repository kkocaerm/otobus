<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/HeaderButton"
            android:contentDescription="@string/back"
            android:text="←"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/on_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_subtitle"
                android:textColor="@color/on_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFav"
            style="@style/HeaderButton"
            android:contentDescription="@string/favorite"
            android:text="☆"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnRefresh"
            style="@style/HeaderButton"
            android:contentDescription="@string/refresh"
            android:text="⟳"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="invisible" />

    <!-- Ana ekran -->
    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/etLine"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_line"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="10"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:backgroundTint="@color/primary"
                android:minWidth="88dp"
                android:text="@string/search"
                android:textColor="@color/on_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHomeMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textColor="@color/error"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:text="@string/favorites"
            android:textAllCaps="true"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNoFavs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_favs"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <ListView
            android:id="@+id/lvFavs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp" />
    </LinearLayout>

    <!-- Hat ekranı -->
    <LinearLayout
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/dirBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/btnDirA"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnDirB"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAllCaps="false"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <ListView
            android:id="@+id/lvRows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp" />
    </LinearLayout>
</LinearLayout>
